
pipeline {
    agent any

    stages {
        stage('Pre-check Docker') {
            steps {
                sh 'docker --version'
                sh 'docker ps'
            }
        }

        stage('Build Docker Image') {
            steps {
                sh 'docker build -t delivery-monitoring:latest .'
            }
        }

        stage('Run Application') {
            steps {
                sh '''
                    docker rm -f delivery-monitoring-app || true
                    docker run -d \
                        --name delivery-monitoring-app \
                        --network monitoring \
                        -p 8001:8000 \
                        delivery-monitoring:latest
                '''
            }
        }

        stage('Verify Metrics') {
            steps {
                sh '''
                    sleep 5
                    docker logs --tail 20 delivery-monitoring-app
                    docker exec delivery-monitoring-app \
                        python -c "import urllib.request; print(urllib.request.urlopen('http://localhost:8000/metrics').status)"
                '''
            }
        }
    }

    post {
        success {
            echo 'Delivery monitoring pipeline completed successfully!'
        }
        failure {
            echo 'Pipeline failed. Check the console output.'
        }
    }
}
