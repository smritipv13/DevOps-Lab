
pipeline {
    agent any

    stages {
        stage('Build') {
            steps {
                echo 'Checking Python and Flask'
                sh 'python3 --version'
                sh 'python3 -c "import flask; print(flask.__version__)"'
            }
        }

        stage('Test') {
            steps {
                echo 'Running unit tests'
                dir('MySolutions/Exercise-9') {
                    sh 'python3 -m unittest discover -s . -p "test*.py"'
                }
            }
        }

        stage('Deploy') {
            steps {
                echo 'Deploying application'
                sh '''
                    mkdir -p "$WORKSPACE/python-app-deploy"
                    cp "$WORKSPACE/MySolutions/Exercise-9/app.py" "$WORKSPACE/python-app-deploy/"
                    cp "$WORKSPACE/MySolutions/Exercise-9/test_app.py" "$WORKSPACE/python-app-deploy/"
                '''
            }
        }

        stage('Run Application') {
            steps {
                echo 'Starting Flask application'
                sh '''
                    cd "$WORKSPACE/python-app-deploy"
                    nohup python3 app.py > app.log 2>&1 &
                    echo $! > app.pid
                    sleep 2
                '''
            }
        }

        stage('Test Application') {
            steps {
                echo 'Testing deployed application'
                dir('python-app-deploy') {
                    sh 'python3 test_app.py'
                }
            }
        }
    }

    post {
        success {
            echo 'Pipeline completed successfully!'
        }
        failure {
            echo 'Pipeline failed. Check the logs for more details.'
        }
    }
}
